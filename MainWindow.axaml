<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WorldApp.MainWindow"
        x:CompileBindings="False"
        Title="Частоты слов" Width="800" Height="600">
	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="200"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<TextBox Name="InputText" Grid.Row="0"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 PlaceholderText="Вставьте сюда текст..."/>

		<Button Grid.Row="1" Content="Построить гистограмму"
                Click="OnBuildClick" Margin="0,10"/>

		<ScrollViewer Grid.Row="2">
			<ItemsControl Name="HistogramItems">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<StackPanel Orientation="Horizontal" Margin="2">
							<TextBlock Text="{Binding Word}" Width="150"/>
							<Rectangle Width="{Binding BarWidth}" Height="20"
                                       Fill="SteelBlue" VerticalAlignment="Center"/>
							<TextBlock Text="{Binding Count}" Margin="5,0,0,0"
                                       VerticalAlignment="Center"/>
						</StackPanel>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
	</Grid>
</Window>